{
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/diagram-commit-guard.sh\"",
            "statusMessage": "Checking class diagram is in sync"
          }
        ]
      }
    ]
  }
}
