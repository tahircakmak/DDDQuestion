@startuml domain-model
skinparam classAttributeIconSize 0
hide empty members

package "Domain" {
  class Employee <<AggregateRoot>> {
    + Id: int
    + FullName: string
    + ManagerId: int?
    + GrantedAnnualLeaveDays: int
    + OpenVacationRequest(requestedDays: int): void
  }

  class Vacation <<Entity>> {
    + Id: int
    + EmployeeId: int
    + AssignedManagerId: int
    + Days: int
    + Status: RequestStatus
    + {static} Create(employee: Employee, requestedDays: int): Vacation
    + Approve(vacationRepository, payrollClient): void
  }

  enum RequestStatus {
    RequestOpened
    Approved
  }

  Employee "1" *-- "0..*" Vacation : owns >
  Vacation --> RequestStatus
  Employee "0..1" --> "0..*" Employee : manages >
}

package "Datasource" {
  class HumanResourcesDbContext {
    + Employees: DbSet<Employee>
    + Vacations: DbSet<Vacation>
    + OnModelCreating(modelBuilder): void
  }

  class HRUnitOfWork {
    + VacationRepository: VacationRepository
    + EmployeeRepository: EmployeeRepository
    + SaveChanges(): void
  }

  HRUnitOfWork o-- HumanResourcesDbContext
  HRUnitOfWork o-- "1" VacationRepository
  HRUnitOfWork o-- "1" EmployeeRepository
  HumanResourcesDbContext ..> Employee
  HumanResourcesDbContext ..> Vacation
}

package "Domain Services" {
  interface IPayrollSystem {
    + AddUnpaidVacation(employeeId: int): void
  }

  class EmployeeRepository {
    + EmployeeRepository(db: HumanResourcesDbContext)
  }

  class VacationRepository {
    + GetOpenRequestsForUser(userId: int): IEnumerable<Vacation>
    + GetById(vacationId: int): Vacation
    + GetApprovedVacationDays(employeeId: int): int
  }
}

package "FrameworkX.Common" {
  interface "IRepository<TModel>" as IRepository {
    + Delete(model: TModel): void
    + FindById(primaryFieldValue: int): TModel
    + Insert(model: TModel): void
  }

  class "EFRepositoryBase<TDbContext, TModel>" as EFRepositoryBase {
    # db: TDbContext
    + FindById(primaryFieldValue: int): TModel
    + Find(filterExpression): IQueryable<TModel>
    + Insert(model: TModel): void
    + Delete(model: TModel): void
  }

  EFRepositoryBase ..|> IRepository
}

EmployeeRepository --|> EFRepositoryBase
EmployeeRepository ..> Employee : reads/writes
VacationRepository ..> Vacation : reads/writes
Vacation ..> VacationRepository : uses
Vacation ..> IPayrollSystem : uses

note right of Vacation
  Approve() takes a repository and an
  external service client as parameters
  (see "ToDo: Is it Ok?" in source) --
  a domain entity depending directly on
  infrastructure is a smell worth revisiting.
end note

@enduml
